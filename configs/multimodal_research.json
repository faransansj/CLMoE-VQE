  "common_training": {"optimizer": "AdamW", "lr": 0.0003, "epochs": 5, "batch_size": 16, "micro_batch_size": 8},
  "optimizer_details_gate": "explicitly pin betas, epsilon, weight decay, precision and scheduler before G0 runs",
  "development_grid": {"lr": [0.0001, 0.0003], "epochs": [5, 10]},
  "common_methods": ["shared_lora", "capacity_matched_shared", "replay_lora", "expand"],
  "capacity_matching": {"rank_formula": "8 * task_count", "alpha_formula": "2 * rank"},
  "replay": {"images_per_previous_task": 64, "replacement_fraction": 0.5},
  "confirmation_controls": ["frozen_first", "independent_common_budget", "validation_tuned_replay"],
  "reuse_identical_configs": true,
  "planned_training_jobs": {
