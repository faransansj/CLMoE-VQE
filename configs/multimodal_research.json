  "architecture": {
    "backbone": "same pure-pretraining BLIP VQA graph and checkpoint as archived readout cohort",
    "caption_instruction": "Describe the image.",
    "rank": 8,
    "alpha": 16,
    "image_size": 224,
    "loss": "mean over valid shifted target tokens per example, then mean over examples; keep BLIP smoothing",
