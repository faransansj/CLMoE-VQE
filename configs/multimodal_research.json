    "confirmation_common": 128,
    "confirmation_frozen_first": 32,
    "confirmation_independent": 32,
    "confirmation_tuned_replay_max": 32,
    "confirmation_total_min": 192,
    "confirmation_total_max": 224
  },
  "routing_variants": ["native_joint", "image_only", "question_only", "family_restricted_joint", "task_id_oracle"],
  "routing_parent_banks": 32,
  "routing_conditions": 160,
  "routing_expert_retraining": 0,
  "normalization": "task score / locked positive G1 independent validation score; no clipping; equal family weighting",
  "primary_comparisons": [
    {"family": "vqa", "method": "expand", "baseline": "shared_lora"},
    {"family": "vqa", "method": "expand", "baseline": "capacity_matched_shared"},
    {"family": "vqa", "method": "expand", "baseline": "replay_lora"},
    {"family": "caption", "method": "expand", "baseline": "shared_lora"},
    {"family": "caption", "method": "expand", "baseline": "capacity_matched_shared"},
    {"family": "caption", "method": "expand", "baseline": "replay_lora"}
  ],
  "statistics": {
    "unit": "seed; average paired differences over the four fixed orders before inference",
    "primary_endpoint": "family_normalized_final_score",
    "test": "exact_two_sided_paired_sign_flip",
    "correction": "Holm_across_all_6_primary_tests",
    "bootstrap_replicates": 20000,
    "confidence": 0.95,
    "ci": "paired_seed_percentile_not_simultaneous",
    "exploratory": ["forgetting", "transfer", "routing", "individual_task_order", "tuned_replay"],
    "tuned_replay_correction": "separate_Holm_family_of_2_exploratory_AP_tests"
